#include<stdio.h>

float celsiustoFahrenheit(float c);
float fahrenheittoCelsius(float f);


  int main()
{
  int choice;

  float temperature;
  float result;

  printf("\t======TEMPERATURE CONVERTER======");
  printf("\n\n1 - Celsius to Fahrenheit\n2 - Fahrenheit to Celsius");

  printf("\n\nChoice: ");
  scanf("%d", &choice );

    
  switch(choice){

      case 1:
      printf("Enter Celsius value: ");
      scanf("%f", &temperature);

      result = celsiustoFahrenheit(temperature);
      printf("%.1f C = %.1f F", temperature, result);         
    
      break;
      
      case 2:
      printf("Enter Fahrenheit value: ");
      scanf("%f", &temperature);
          
      result = fahrenheittoCelsius(temperature);    
      printf("%.1f F = %.1f C", temperature, result);   
    
      break;

      default:
      printf("\nINVALID INPUTS!");
      break;
      
  }
    
  return 0;
}

float celsiustoFahrenheit(float c){
    float result;
    
    result= (c * 9.0 / 5.0) + 32;
    return result;
}

float fahrenheittoCelsius(float f){
    float result;
    
    result= (f - 32) * 5.0 / 9.0;
    return result;
}
