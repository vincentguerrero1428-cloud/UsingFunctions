#include<stdio.h>

int GetFactorial(int number);

    int main()
{
    int number, answer;

    printf("\t======FACTORIAL OF NUMBERS======\n");
    printf("Enter a number: ");
    scanf("%d", &number);

    answer=GetFactorial(number);
    
    printf("\nFactorial of %d is: %d!", number, answer);
    
    return 0;
}

int GetFactorial(int number){

    int result=1;

    for(int i=1; i<=number; i++){
       result= result*i;  
    }
        return result;
    
}
